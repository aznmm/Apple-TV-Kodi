<?xml version="1.0" encoding="UTF-8"?>
<addons>
<addon id="repository.appletv" name="Apple TV Kodi Repository" version="1.0.0" provider-name="aznmm">
  <requires>
    <import addon="xbmc.addon" version="12.0.0"/>
  </requires>
  <extension point="xbmc.addon.repository" name="Apple TV Kodi Repository">
    <dir>
      <info compressed="false">https://aznmm.github.io/Apple-TV-Kodi/addons/addons.xml</info>
      <checksum>https://aznmm.github.io/Apple-TV-Kodi/addons/addons.xml.md5</checksum>
      <datadir zip="true">https://aznmm.github.io/Apple-TV-Kodi/addons/</datadir>
      <hashes>sha256</hashes>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Repository for the Apple TV-inspired Kodi setup.</summary>
    <description lang="en_GB">A personal add-on repository for the Apple-TV-Kodi project.</description>
    <platform>all</platform>
    <license>MIT</license>
    <assets/>
  </extension>
</addon>
<addon id="skin.orchard" version="0.2.0" name="Orchard" provider-name="Orchard (built on Estuary by phil65 and Ichabod Fletchman)">
  <requires><import addon="xbmc.gui" version="5.17.0"/></requires>
  <extension point="xbmc.gui.skin" debugging="false"><res width="1920" height="1080" aspect="16:9" default="true" folder="xml"/></extension>
  <extension point="xbmc.addon.metadata">
    <platform>all</platform>
    <summary lang="en_GB">A streaming-style skin inspired by the Apple TV app.</summary>
    <description lang="en_GB">Orchard makes Kodi feel like the Apple TV app. Built on Kodi's Estuary skin.</description>
    <license>CC BY-SA 4.0, GNU GENERAL PUBLIC LICENSE Version 2.0</license>
    <assets><icon>resources/icon.png</icon><fanart>resources/fanart.jpg</fanart></assets>
  </extension>
</addon>
</addons>
